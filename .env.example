# Optionaler Master-Key zur Verschluesselung der in der App gespeicherten
# Zugangsdaten (Fernet-Key, 32 Byte urlsafe-base64). Wenn nicht gesetzt,
# erzeugt die App beim ersten Start automatisch einen Key und speichert ihn
# in data/encryption.key. Fuer produktive/oeffentliche Deployments empfohlen,
# diesen Wert explizit als Secret zu setzen, z.B.:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Verzeichnis fuer SQLite-DB + Encryption-Key (im Container, per Volume mounten)
DATA_DIR=/data

# Port, auf dem die Web-GUI im Container lauscht
PORT=8000
